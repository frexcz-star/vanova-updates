# MAIOS Connector environment template.
# COPY this file to `.env` and fill in real values. NEVER commit .env.
# Or run `python install_connector.py` to generate a .env automatically.

# Public URL of MAIOS Cloud (use https in production)
MAIOS_CLOUD_URL=http://127.0.0.1:8000

# Device key: a long secret that identifies this connector. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Register it in MAIOS Cloud -> Settings -> Devices.
MAIOS_DEVICE_KEY=

# Workspace id (set after onboarding)
MAIOS_WORKSPACE_ID=

# Owner token: lets the connector self-register against the Cloud.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAIOS_OWNER_TOKEN=

# Local Hermes Agent (NEVER exposed to internet; only used locally)
# Option A (recommended): Hermes via CLI. Full path to the hermes launcher.
#   e.g. C:\Users\<user>\AppData\Local\hermes\hermes-agent\venv\Scripts\hermes.exe
HERMES_CLI=
# Option B (legacy): Hermes HTTP server. Only if you run the API on 8642.
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Heartbeat interval (seconds)
MAIOS_HEARTBEAT_SECONDS=30
