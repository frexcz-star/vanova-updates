# MAIOS environment template — copy to `.env` and fill in values.
# NEVER commit real `.env` files. Per-install secrets are generated at first run
# under %LOCALAPPDATA%/MAIOS/config/ (see install_secrets.py).

# --- Per-installation (generated automatically; do not set in repo .env) ---
MAIOS_RUNTIME_TOKEN=
MAIOS_INSTALLATION_ID=
MAIOS_DEVICE_IDENTITY=
MAIOS_ENCRYPTION_KEY_FOUNDATION=

# --- MAIOS Cloud ---
MAIOS_CLOUD_SECRET_KEY=
MAIOS_DEMO_USER=
MAIOS_DEMO_PASSWORD=
MAIOS_TOKEN_MINUTES=60
MAIOS_REFRESH_DAYS=7
MAIOS_DB=
MAIOS_AUDIT_LOG=
MAIOS_ALLOWED_ORIGINS=
# MAIOS_STATIC_DIR=

# --- MAIOS Connector ---
MAIOS_CLOUD_URL=http://127.0.0.1:8000
MAIOS_DEVICE_KEY=
MAIOS_WORKSPACE_ID=
MAIOS_OWNER_TOKEN=
MAIOS_HEARTBEAT_SECONDS=30

# --- Hermes / AI (optional) ---
HERMES_CLI=
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
MAIOS_AI_PROVIDER=
MAIOS_AI_MODEL=
MAIOS_AI_API_KEY=
