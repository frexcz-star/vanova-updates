# MAIOS Cloud environment template.
# COPY this file to `.env` and fill in real values. NEVER commit .env.
#
# Security: use a long random SECRET key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Secrets
MAIOS_CLOUD_SECRET_KEY=
MAIOS_DEMO_USER=
MAIOS_DEMO_PASSWORD=

# Token lifetimes
MAIOS_TOKEN_MINUTES=60
MAIOS_REFRESH_DAYS=7

# Storage (portable; no external DB required)
MAIOS_DB=./maios_cloud.db
MAIOS_AUDIT_LOG=./audit.jsonl

# CORS: comma-separated allowed origins. Empty = allow same-origin + localhost dev.
MAIOS_ALLOWED_ORIGINS=

# If the frontend is built, point here (optional)
# MAIOS_STATIC_DIR=../web/dist
